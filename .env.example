APP_ENV=local
DATABASE_URL=mariadb+pymysql://user:pass@host:3306/dbname?charset=utf8mb4
CHUNK_SIZE=500

DB_HOST=mariadb.iwks.fraunhofer.de
DB_PORT=3306
DB_USER=...
DB_PASSWORD=...
DB_NAME=MFA_K3I
DB_DRIVER=mariadb+pymysql     # keep this unless you switch to mariadbconnector

DB_SSL=1
DB_SSL_VERIFY=1               # set to 0 only if verification really must be disabled
# DB_SSL_CA=C:\path\to\corp-ca.pem   # optional; if omitted we use certifi’s bundle

DB_SSL=1
DB_SSL_VERIFY=1          # set to 0 only if the server requires no verification (not recommended)
# DB_SSL_CA=C:\path\to\ca-bundle.pem   # optional; if omitted we’ll use certifi’s bundle
# DB_DRIVER=mariadb+pymysql            # current default; keep unless you decide to switch drivers
